################################################################
# Containerfile: CPU Inference Service (FastAPI + PyTorch)     #
################################################################
# This Containerfile builds a REPRODUCIBLE, MINIMAL, and SAFE
# container image for serving the CXR classifier via FastAPI.
#
# Notebook 06 explains the rationale behind each layer.
#
# This version:
#   - runs on CPU (no CUDA)
#   - loads preprocessing_config.json at startup
#   - exposes /health, /metadata, /predict endpoints
#   - uses dummy prediction until model integration step
#
# GPU support and checkpoint loading are added in a later stage:
#   (Notebook 06, Section: Model Integration + GPU Variant)
################################################################

#########################
# 1. Choose base image  #
#########################
# python:3.10-slim keeps the image small, secure, and fast to build.
FROM python:3.10-slim AS base

# Build metadata: the git commit this image was built from, and when.
# Passed in by CI (and by local builds) as build args, surfaced at runtime
# via the /dashboard-metrics endpoint. Defaults make local builds harmless.
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV CXR_GIT_COMMIT=${GIT_COMMIT}
ENV CXR_BUILD_TIME=${BUILD_TIME}

#########################
# 2. Install OS deps    #
#########################
# Install ONLY what is required for PIL (pillow), torch, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libjpeg-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

###########################
# 3. Create non-root user #
###########################
# SECURITY BEST PRACTICE:
# Do not run inference services as root.
RUN useradd -m appuser
USER appuser

# Ensure pip-installed scripts (uvicorn, fastapi, watchfiles, etc.)
# are available on PATH for this non-root user.
ENV PATH="/home/appuser/.local/bin:${PATH}"

##############################
# 4. Create application dirs #
##############################
WORKDIR /app

# Make /app the Python import root.
# This ensures that:
#   - `app.*` imports resolve correctly
#   - `src.*` imports resolve correctly
# without relying on implicit working-directory behaviour.
#
# This matches how Python was executed during local development
# when using: PYTHONPATH=. uvicorn ...
ENV PYTHONPATH=/app

# Directory structure INSIDE the container:
# /app
#   ├── app/               <-- FastAPI code
#   ├── src/               <-- shared transforms (deployment-safe)
#   ├── config/            <-- preprocessing_config.json (mounted)
#   └── requirements.txt


##############################
# 5. Copy dependency file    #
##############################
COPY --chown=appuser:appuser deployment/api/requirements-cpu.txt /app/requirements-cpu.txt

# 5.5 Copy pre-downloaded CPU wheels (to avoid PyPI timeouts)
COPY --chown=appuser:appuser deployment/api/wheels-cpu/ /app/wheels/


##################################
# 6. Install Python dependencies #
##################################
RUN pip install --no-cache-dir --no-index --find-links=/app/wheels -r /app/requirements-cpu.txt

#############################
# 7. Copy API application   #
#############################
COPY --chown=appuser:appuser deployment/api/app/ /app/app/
COPY --chown=appuser:appuser src/ /app/src/
COPY --chown=appuser:appuser deployment/api/config/ /app/config/

#############################
# 8 Copy demo UI          #
#############################
# Copy the demo HTML interface so clients can access it at /demo/
COPY --chown=appuser:appuser deployment/api/demo/ /app/demo/

###########################################################
# IMPORTANT: NOTE FOR LATER (DO NOT FORGET)
# This placeholder remains until a real model is mounted
# and load a checkpoint (Notebook 06: Model Integration).
#
# At this stage, only the API skeleton is tested.
###########################################################

###############################
# 9. Expose port for FastAPI  #
###############################
EXPOSE 8000

###########################################################
# 10. Entrypoint: Uvicorn server                           #
###########################################################
# Runs:
# uvicorn app.main:app --host 0.0.0.0 --port 8000
#
# --host 0.0.0.0 ensures external clients can access the service
###########################################################
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

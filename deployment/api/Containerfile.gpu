################################################################
# Containerfile: GPU Inference Service (FastAPI + PyTorch)     #
################################################################
# Same API as the CPU image, but with CUDA support enabled.
#
# Requirements:
#   - NVIDIA GPU on host
#   - Podman run with:  --gpus all
#   - Torch installed WITH CUDA
################################################################

#########################
# 1. Base image (CUDA)  #
#########################
# CUDA 12.8 – REQUIRED for RTX 5090 (Blackwell)
FROM docker.io/nvidia/cuda:12.8.0-runtime-ubuntu22.04 AS base

#########################
# 2. Install OS deps    #
#########################
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-distutils \
        gcc \
        libjpeg-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/bin/python

###########################
# 3. Create non-root user #
###########################
RUN useradd -m appuser
USER appuser

ENV PATH="/home/appuser/.local/bin:${PATH}"

##############################
# 4. Create application dirs #
##############################
WORKDIR /app

# Make /app the Python import root (matches CPU image)
ENV PYTHONPATH=/app

##############################
# 4. Copy requirements (non-Torch)
##############################
COPY --chown=appuser:appuser deployment/api/requirements-gpu.txt /app/requirements-gpu.txt

##############################
# 5. Copy local PyTorch wheels
##############################
COPY --chown=appuser:appuser deployment/api/wheels-gpu/ /app/wheels/

##################################
# 6. Install dependencies (OFFLINE)
##################################

# Install ALL deps from local wheels only (no PyPI)
RUN pip install --no-cache-dir --no-index --find-links=/app/wheels -r /app/requirements-gpu.txt

# Install PyTorch stack from LOCAL CUDA wheels
RUN pip install --no-cache-dir --no-index --find-links=/app/wheels \
    torch torchvision torchaudio

#############################
# 7. Copy API application   #
#############################
COPY --chown=appuser:appuser deployment/api/app/ /app/app/

# Copy shared project code needed by the API (shared transforms).
COPY --chown=appuser:appuser src/ /app/src/
COPY --chown=appuser:appuser deployment/api/config/ /app/config/

#############################
# 8 Copy demo UI          #
#############################
# Copy the demo HTML interface so clients can access it at /demo/
COPY --chown=appuser:appuser deployment/api/demo/ /app/demo/

###############################
# 9. Expose port for FastAPI  #
###############################
EXPOSE 8000

###########################################################
# 10. Entrypoint                                            #
###########################################################
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]


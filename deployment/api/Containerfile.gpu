################################################################
# Containerfile: GPU Inference Service (FastAPI + PyTorch)     #
################################################################
# Same API as the CPU image, but with CUDA support enabled.
#
# Requirements:
#   - NVIDIA GPU on host
#   - Podman run with:  --gpus all
#   - Torch installed WITH CUDA
################################################################

#########################
# 1. Base image (CUDA)  #
#########################
# CUDA 12.8 – REQUIRED for RTX 5090 (Blackwell)
FROM docker.io/nvidia/cuda:12.8.0-runtime-ubuntu22.04 AS base

#########################
# 2. Install OS deps    #
#########################
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-distutils \
        gcc \
        libjpeg-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3 /usr/bin/python

###########################
# 3. Create non-root user #
###########################
RUN useradd -m appuser
USER appuser

ENV PATH="/home/appuser/.local/bin:${PATH}"

##############################
# 4. Copy requirements (non-Torch)
##############################
COPY --chown=appuser:appuser deployment/api/requirements-gpu.txt /app/requirements-gpu.txt

##############################
# 5. Copy local PyTorch wheels
##############################
COPY --chown=appuser:appuser deployment/api/wheels/ /app/wheels/

##################################
# 6. Install dependencies
##################################

# 1) Install FastAPI, numpy, pandas, etc.
RUN pip install --no-cache-dir -r /app/requirements-gpu.txt

# 2) Install PyTorch stack from LOCAL wheels
RUN pip install --no-cache-dir --no-index --find-links=/app/wheels \
        torch torchvision torchaudio

#############################
# 7. Copy API application   #
#############################
COPY --chown=appuser:appuser deployment/api/app/ /app/app/
ENV PYTHONPATH="/app:${PYTHONPATH}"

###############################
# 8. Expose port for FastAPI  #
###############################
EXPOSE 8000

###########################################################
# 9. Entrypoint                                            #
###########################################################
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

